{
	"name": "pi-video-analyser",
	"version": "0.1.0",
	"description": "Pi extension: analyse local video files with a configured model through an OpenAI-compatible endpoint",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"video",
		"analysis"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	},
	"dependencies": {
		"openai": "^7.30.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "~1.3.27",
		"typescript": "^5.9.3",
		"@types/node": "^24.0.0"
	},
	"files": [
		"index.ts",
		"lib/**/*.ts",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	}
}
